{
  "name": "etresorerie-executive-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Application Android Executive eTresorerie en lecture seule",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:assets": "npx capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/app": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0",
    "@capacitor/assets": "^4.0.0"
  }
}